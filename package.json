{
  "name": "gga-roll-clarity",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Farmeroz/gga-roll-clarity.git"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "fflate": "0.8.2",
    "happy-dom": "20.8.4",
    "playwright": "1.62.1",
    "linkedom": "0.18.12"
  },
  "scripts": {
    "test:setup": "node tools/test-sources.mjs",
    "test": "node tools/run-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:syntax": "node tools/check-syntax.mjs",
    "build": "node tools/build-release.mjs",
    "test:browser": "node tests/browser-tests.cjs",
    "check": "npm run format:check && npm run check:syntax && npm test && npm run test:browser && npm run build"
  }
}
